# copy to .env. docker compose and the tracer binary both read these from the environment.
TRACER_PG_PASSWORD=tracer
TRACER_PG_PORT=5432
TRACER_DB=postgres://tracer:tracer@localhost:5432/tracer
TRACER_LISTEN=127.0.0.1:3000
TRACER_UI_DIR=ui/dist
# whose clock "today" follows (dates left blank, subscription renewals, reminders): a tz name like Asia/Kolkata
TRACER_TZ=UTC
# open: anyone can create an account. closed: only `tracer user add` can
TRACER_SIGNUPS=open
# set when a reverse proxy in front sets X-Forwarded-For, so rate limits see the real client
TRACER_TRUST_PROXY=
# seconds between background runs (subscription renewals, reminders, tidying); 0 turns them off
TRACER_JOB_SECS=900
TRACER_DB_POOL=16
# the address people reach the server at (https in production). Google and GitHub send them back to
# <it>/api/auth/google/callback and <it>/api/auth/github/callback
TRACER_PUBLIC_URL=http://127.0.0.1:3000
# sign in with Google (Google Cloud console > APIs & Services > Credentials > OAuth client, "web application")
TRACER_GOOGLE_CLIENT_ID=
TRACER_GOOGLE_CLIENT_SECRET=
# sign in with GitHub (Settings > Developer settings > OAuth Apps)
TRACER_GITHUB_CLIENT_ID=
TRACER_GITHUB_CLIENT_SECRET=
