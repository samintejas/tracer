# copy to .env. docker compose and the pebblelab binary both read these from the environment.
PEBBLELAB_PG_PASSWORD=pebblelab
PEBBLELAB_PG_PORT=5432
PEBBLELAB_DB=postgres://pebblelab:pebblelab@localhost:5432/pebblelab
PEBBLELAB_LISTEN=127.0.0.1:3000
PEBBLELAB_UI_DIR=ui/dist
# whose clock "today" follows (dates left blank, subscription renewals, reminders): a tz name like Asia/Kolkata
PEBBLELAB_TZ=UTC
# open: anyone can create an account. closed: only `pebblelab user add` can
PEBBLELAB_SIGNUPS=open
# true when a reverse proxy in front sets X-Forwarded-For, so rate limits see the real client
PEBBLELAB_TRUST_PROXY=false
# seconds between background runs (subscription renewals, reminders, tidying); 0 turns them off
PEBBLELAB_JOB_SECS=900
PEBBLELAB_DB_POOL=16
# the address people reach the server at (https in production). Google and GitHub send them back to
# <it>/api/auth/google/callback and <it>/api/auth/github/callback
PEBBLELAB_PUBLIC_URL=http://127.0.0.1:3000
# sign in with Google (Google Cloud console > APIs & Services > Credentials > OAuth client, "web application")
PEBBLELAB_GOOGLE_CLIENT_ID=
PEBBLELAB_GOOGLE_CLIENT_SECRET=
# sign in with GitHub (Settings > Developer settings > OAuth Apps)
PEBBLELAB_GITHUB_CLIENT_ID=
PEBBLELAB_GITHUB_CLIENT_SECRET=
# send email (password resets) through Resend: an API key from resend.com. Empty = no email
PEBBLELAB_RESEND_API_KEY=
# who it comes from: an address on a domain verified in Resend, e.g. "pebblelab/fin <noreply@pebblelab.in>".
# The default only delivers to the address your Resend account was made with.
PEBBLELAB_MAIL_FROM="pebblelab/fin <onboarding@resend.dev>"
# only let people in through Google or GitHub: turns off email-and-password sign-up, sign-in and reset. Needs a provider above
# PEBBLELAB_NO_PASSWORD_LOGIN=true
